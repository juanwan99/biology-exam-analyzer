DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key
DATABASE_URL=postgresql://user:pass@localhost:5432/biology_exam
SECRET_KEY=your-secret-key

# LLM Provider
LLM_SA_CREDENTIALS=/app/.credentials/sa-key.json
LLM_PROJECT=your-project-id
LLM_LOCATION=global
LLM_SDK_MODULE=google.genai
LLM_CLOUD_MODE=true
LLM_EXAM_REVIEW_FLASH_MODEL=publishers/google/models/gemini-3-flash-preview
LLM_EXAM_REVIEW_PRO_MODEL=publishers/google/models/gemini-3.1-pro-preview
# Legacy global override. Ignored unless LLM_ALLOW_NATIVE_MODEL_OVERRIDE=true.
LLM_ALLOW_NATIVE_MODEL_OVERRIDE=false
LLM_NATIVE_MODEL=
LLM_API_KEY=your-api-key

# Discovery Engine / GenAI App Builder
# Optional: when empty, the client reuses LLM_PROJECT and LLM_SA_CREDENTIALS.
DISCOVERY_ENGINE_PROJECT_ID=
DISCOVERY_ENGINE_PROJECT_NUMBER=
DISCOVERY_ENGINE_DATA_STORE_ID=
DISCOVERY_ENGINE_ENGINE_ID=
DISCOVERY_ENGINE_CREDENTIALS=
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION=default_collection
DISCOVERY_ENGINE_RANKING_CONFIG=default_ranking_config
DISCOVERY_ENGINE_GROUNDING_CONFIG=default_grounding_config
DISCOVERY_ENGINE_SERVING_CONFIG=default_search
DISCOVERY_ENGINE_TIMEOUT=90
# Search App answer_query has a separate per-minute quota. Keep this conservative
# because agent_search calls it once per question and fails closed on quota errors.
DISCOVERY_ENGINE_ANSWER_QPM=12
DISCOVERY_ENGINE_ANSWER_RETRIES=3
DISCOVERY_ENGINE_ANSWER_RETRY_BASE_DELAY=20

# Review channel switch:
# - app_builder: use Discovery Engine Ranking for question review context and
#   Check Grounding for report conclusions.
# - model: use the configured LLM provider chain without Discovery Engine.
# - empty: honor the legacy REPORT_GROUNDING_ENABLED/EVIDENCE_RANKING_ENABLED flags.
EXAM_REVIEW_CHANNEL=app_builder

# Report-level grounding gate. Keep disabled until Discovery Engine billing and
# credentials are confirmed in the target environment.
REPORT_GROUNDING_ENABLED=true
REPORT_GROUNDING_MIN_SUPPORT=0.6
REPORT_GROUNDING_CITATION_THRESHOLD=0.6

# Question-level evidence ranking. Keep disabled by default because each
# analyzed question calls Discovery Engine Ranking when enabled.
EVIDENCE_RANKING_ENABLED=true
EVIDENCE_RANKING_TOP_N=5
