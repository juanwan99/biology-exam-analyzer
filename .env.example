# Gemini API 配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE=https://api.example.com/v1

# Claude API 配置（难度评估特征提取）
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_API_BASE=https://api.anthropic.com/v1

# 管理员密码（生产环境请使用强密码）
ADMIN_PASSWORD=change_me_in_production

# 数据库配置（可选，默认使用 Docker 容器内部网络）
DATABASE_URL=postgresql://biology:your_db_password@postgres:5432/biology_edu
POSTGRES_PASSWORD=your_db_password

# 环境（development / production）
ENV=development

# 性能配置（可选）
MAX_WORKERS=21
API_REQUEST_INTERVAL=0.2
SESSION_EXPIRE_MINUTES=30

# CORS 配置（生产环境请修改为实际域名）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 日志级别
LOG_LEVEL=INFO

VECTO_API_KEY=your-vecto-api-key
VECTO_API_BASE=https://api.vectorengine.ai/v1/chat/completions
